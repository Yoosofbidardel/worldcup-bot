# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Football-Data.org API Key (free: https://www.football-data.org/client/register)
FOOTBALL_API_KEY=your_football_data_api_key_here

# Competition code (WC = FIFA World Cup)
COMPETITION_CODE=WC

# How often to poll the API for match updates (in minutes)
POLL_INTERVAL_MINUTES=5

# Timezone for display (IANA format)
DISPLAY_TIMEZONE=Europe/Amsterdam
